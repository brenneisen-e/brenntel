/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block

/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Revalidate CSS/JS on every load. The ?v= query strings in the HTML are
# maintained by hand and were missed more than once, which served stale
# styles and scripts for a day. Revalidation costs a 304 and removes that
# whole failure mode; only the pinned vendor bundle below is cached hard.
/css/*
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

# Nach /js/* notiert, damit die längere Cache-Zeit für die Vendor-Datei gewinnt
/js/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
